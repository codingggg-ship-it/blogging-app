<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title><%= blog.title %></title>
  </head>

  <body>
    <%- include('./partials/nav') %>

    <div class="container mt-4">
      <img
        src="<%= blog.coverImageURL %>"
